<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/integration-bootstrap.php" colors="true" cacheDirectory=".workbench/phpunit-cache">
    <testsuites><testsuite name="Native Laravel"><directory>tests/Integration</directory></testsuite></testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
    </php>
</phpunit>
